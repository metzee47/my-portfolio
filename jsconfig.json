{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/components": ["src/components/*"],
      "@/constants": ["src/constants/*"],
      "@/hooks": ["src/hooks/*"],
      "@/api": ["src/api/*"],
      "@/assets": ["src/assets/*"],
      "@/lib": ["src/lib/*"],
      "@/context": ["src/context/*"],
      "@/pages": ["src/pages/*"],
      "@/routes": ["src/routes/*"],
      "@/styles": ["src/styles/*"]
    }
  }
}
